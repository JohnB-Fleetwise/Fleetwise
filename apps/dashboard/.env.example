# PostgreSQL connection string (Neon serverless). Required.
DATABASE_URL=postgres://user:password@host/dbname

# Secret used by NextAuth to sign session cookies and JWTs.
# Required in production — set a strong random value (e.g. `openssl rand -base64 32`).
NEXTAUTH_SECRET=

# Google Maps Distance Matrix API key. Optional.
# When unset, drive-time ETAs are unavailable (the app logs a warning).
GOOGLE_MAPS_API_KEY=
