{
  "name": "fleetwise",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/dashboard"
  ],
  "scripts": {
    "dev:dashboard": "npm run dev --workspace=@fleetwise/dashboard",
    "dev:mobile": "npm run start --workspace=@fleetwise/mobile",
    "build:shared": "npm run build --workspace=@fleetwise/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "dependencies": {}
}
